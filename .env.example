# GEMINI_API_KEY: optional. With a key the studio offers a managed Gemini path for show writing;
# without one every show is written by the built-in local synthesizer. The station stays on air
# either way, and a quota error or an unavailable model falls back automatically.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: optional. Must be a model the key can reach (default: gemini-3.8-flash).
GEMINI_MODEL="gemini-3.8-flash"

# PORT / HOST: optional. The transmitter binds 0.0.0.0:3000 by default.
PORT=3000
HOST="0.0.0.0"

# APP_URL: the URL where this applet is hosted (self-referential links, OAuth callbacks).
APP_URL="MY_APP_URL"
